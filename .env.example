# ---------------------------------------------------------------------------
# EstateLens environment configuration
# Copy to .env for local development. NEVER commit a real .env.
# In production (Render) these are set in the dashboard, not in the image.
# ---------------------------------------------------------------------------

# --- OpenRouter (free inference routes only) --------------------------------
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Exact model id chosen + tested with a live generation call on 2026-09-09.
# Must be a free route (id ending in ":free"). Re-check with your own key before
# deploying — OpenRouter's free catalogue changes.
OPENROUTER_MODEL=nex-agi/nex-n2.5-mini:free
# Verified free fallback (different provider) used only when the primary is down.
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# --- MongoDB --------------------------------------------------------------
# Local dev (docker-compose) default:
MONGODB_URI=mongodb://mongo:27017
# Production: an Atlas SRV string, e.g.
# mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=estatelens

# --- App -----------------------------------------------------------------
# Public origin of the deployed app (used for building absolute links, CORS).
APP_BASE_URL=http://localhost:8000
# Host-provided port. Render sets this automatically.
PORT=8000
LOG_LEVEL=INFO

# --- Scraper (ingestion only; not needed by the web service) ------------
SCRAPER_USER_AGENT=EstateLensBot/0.1 (+https://github.com/your-org/estatelens; research demo)
SCRAPER_MAX_CONCURRENCY=2
SCRAPER_DELAY_SECONDS=2.0
