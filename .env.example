# ---------------------------------------------------------------------------
# EstateLens environment configuration
# Copy to .env for local development. NEVER commit a real .env.
# In production (Render) these are set in the dashboard, not in the image.
# ---------------------------------------------------------------------------

# --- LLM provider ----------------------------------------------------------
# auto = try Groq → Gemini → OpenRouter (whichever keys are set).
# Or force one: groq | gemini | openrouter
LLM_PROVIDER=auto

# Groq (free tier) — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (free tier) — https://aistudio.google.com/apikey
# Also powers the optional semantic-retrieval layer (embeddings).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# --- Semantic retrieval (optional) -------------------------------------
# When on and GEMINI_API_KEY is set, passage vectors (built with
# `python -m scripts.cli embed`) are blended with the keyword search.
# Set to false for pure lexical retrieval.
SEMANTIC_RETRIEVAL=true
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_WEIGHT=0.55

# OpenRouter — https://openrouter.ai/keys
# Free routes end in ":free" but share a daily account cap.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACK_MODEL=nex-agi/nex-n2.5-mini:free

# --- MongoDB --------------------------------------------------------------
# Local dev (docker-compose) default:
MONGODB_URI=mongodb://mongo:27017
# Production: an Atlas SRV string, e.g.
# mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/?appName=EstateLens
MONGODB_DATABASE=estatelens

# --- App -----------------------------------------------------------------
# Public origin of the deployed app (used for building absolute links, CORS).
APP_BASE_URL=http://localhost:8000
# Host-provided port. Render sets this automatically.
PORT=8000
LOG_LEVEL=INFO

# --- Scraper (ingestion only; not needed by the web service) ------------
SCRAPER_USER_AGENT=EstateLensBot/0.1 (+https://github.com/your-org/estatelens; research demo)
SCRAPER_MAX_CONCURRENCY=2
SCRAPER_DELAY_SECONDS=2.0
