      "id": "dg-astera-facts",
      "question": "What does the collected source say about The Astera by DarGlobal - where is it and what type of property?",
      "source": "darglobal",
      "expected_facts": ["Al Marjan Island", "Ras Al Khaimah", "beach residences and villas"],
      "supporting_ids": [],
      "constraints": {"source": "darglobal"},
      "expect_abstention": false
    },
    {
      "id": "dg-trump-jeddah-handover",
      "question": "When is the handover / completion date for Trump Tower Jeddah according to the collected source?",
      "source": "darglobal",
