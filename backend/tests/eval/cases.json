      "supporting_ids": [],
      "constraints": {"source": "darglobal"},
      "expect_abstention": false
    },
    {
      "id": "dg-price-missing",
      "question": "What is the exact starting price of The Mulliner?",
      "source": "darglobal",
      "expected_facts": ["Not listed in the collected source"],
      "supporting_ids": [],
      "constraints": {"source": "darglobal"},
      "expect_abstention": true
    },
    {
