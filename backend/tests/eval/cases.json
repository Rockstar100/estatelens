      "supporting_ids": [],
      "constraints": {"transaction_type": "sale", "property_type": "apartment", "bedrooms_min": 3, "budget_max": 800000, "currency": "SAR"},
      "expect_abstention": false
    },
    {
      "id": "sale-rent-separation",
      "question": "I only want properties for rent. What is available?",
