      "expected_facts": ["750,000", "SAR", "Haya Nabla", "Madinah", "600 sqm"],
      "supporting_ids": [],
      "constraints": {"source": "wasalt", "city": "Madinah"},
      "expect_abstention": false
    },
    {
      "id": "wasalt-rent-annual",
