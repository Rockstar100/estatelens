      "source": "wasalt",
      "expected_facts": ["35,000", "SAR", "per year", "Al Noor"],
      "supporting_ids": [],
      "constraints": {"source": "wasalt", "transaction_type": "rent"},
      "expect_abstention": false
    },
    {
      "id": "wasalt-services",
      "question": "What does Wasalt say about its services and licensing?",
      "source": "wasalt",
      "expected_facts": ["Real Estate General Authority", "REGA", "electronic real estate services"],
      "supporting_ids": [],
      "constraints": {"source": "wasalt"},
      "expect_abstention": false
    },
    {
      "id": "source-specific-search",
      "question": "Which collected DarGlobal projects mention waterfront or seafront living?",
      "source": "darglobal",
